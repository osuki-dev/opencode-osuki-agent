{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["."],
  "default_agent": "osuki",
  "model": "openai/gpt-5.6-sol",
  "agents": {
    "osuki": { "model": "openai/gpt-5.6-sol#medium" },
    "explore": { "model": "openai/gpt-5.6-luna#low" },
    "plan": { "mode": "all", "model": "openai/gpt-6-astra#high" },
    "general": { "model": "openai/gpt-5.6-terra#medium" },
    "osuki-worker-quick": { "model": "openai/gpt-5.6-luna#low" },
    "osuki-worker-deep": { "model": "openai/gpt-6-astra#high" },
    "osuki-reviewer": { "model": "openai/gpt-6-astra#high" }
  }
}
